{
  "project": {
    "name": "Termrig",
    "command": "termrig",
    "pathCommand": "trig",
    "identifier": "ai.latticetech.termrig",
    "tagline": "Open groups of terminal tabs as one workspace",
    "description": "Termrig is a desktop terminal profile manager. Save a profile with a group of tabs, each with its own shell, starting directory, startup script, font, and colors, and open them all together to recreate a workspace in one step.",
    "license": "MIT",
    "licenseFile": "LICENSE.md",
    "logo": "assets/logo.png",
    "macosIcon": "assets/logo-macos.png",
    "publisher": "Lattice AI, LLC",
    "publisherUrl": "https://latticetech.ai",
    "repositoryUrl": "https://github.com/jchristn/Termrig",
    "copyright": "Copyright (c) 2026 Joel Christner",
    "dataDirectory": "~/.termrig",
    "versionFile": "src/Termrig.App/Termrig.App.csproj",
    "changelog": "CHANGELOG.md",
    "installNotes": ".github/release-install-notes.md"
  },
  "framework": "net10.0",
  "runtimes": [ "win-x64", "win-arm64", "osx-x64", "osx-arm64", "linux-x64", "linux-arm64" ],
  "artifacts": [
    {
      "name": "app",
      "project": "src/Termrig.App/Termrig.App.csproj",
      "executable": "Termrig",
      "kind": "desktop",
      "properties": { "PackAsTool": "false" }
    }
  ],
  "channels": [ "zip", "inno", "app", "tarball", "pkg", "dmg", "deb", "rpm", "appimage" ],
  "prereleaseBeforeOne": false,
  "launchEnvironment": { "TERMRIG_FOREGROUND": "1" },
  "linux": {
    "installDirectory": "/opt/termrig",
    "category": "utils",
    "desktopCategories": "System;TerminalEmulator;Utility;",
    "debDependencies": [
      "libicu78 | libicu77 | libicu76 | libicu75 | libicu74 | libicu73 | libicu72 | libicu71 | libicu70 | libicu69 | libicu67 | libicu66",
      "libx11-6",
      "libice6",
      "libsm6",
      "libxext6",
      "libxrandr2",
      "libxi6",
      "libxcursor1",
      "libxfixes3",
      "libfontconfig1"
    ],
    "rpmDependencies": [ "libicu", "libX11", "libICE", "libSM", "libXext", "libXrandr", "libXi", "libXcursor", "libXfixes", "fontconfig" ]
  },
  "macos": {
    "minimumSystemVersion": "12.0",
    "commandDirectory": "/usr/local/bin"
  },
  "signing": {
    "windows": {
      "isConfigured": false,
      "certificateEnvironment": "WINDOWS_SIGNING_PFX",
      "passwordEnvironment": "WINDOWS_SIGNING_PASSWORD",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "macos": {
      "isConfigured": false,
      "identity": "",
      "installerIdentity": "",
      "notaryProfile": ""
    }
  }
}
